<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>info.chrzanowski.ide-atmosphere.ide-atmosphere</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>IDE Atmosphere</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://chrzanowski.info">Jakub Chrzanowski</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        A quiet, living layer over your IDE: <em>Fireflies</em> on a summer night, <em>Sakura</em> petals in a spring
        breeze, softly falling <em>Snow</em>, fine <em>Rain</em> or a twinkling <em>Starfield</em>, painted across the
        whole window &mdash; editor, tool windows, toolbar and status bar &mdash; without ever intercepting input or
        touching your code.<br><br>
        The atmosphere lives on the frame's glass pane, adapts to Light and Dark themes (optionally with a different
        atmosphere for each), calms down when you are idle and pauses in Power Save mode or when the window is in the
        background. Particles avoid or gather around your mouse pointer and puff away from a click, stir with your
        typing rhythm, speed up while the IDE is busy (builds, indexing, runs, Gradle sync), rise for a moment when
        something succeeds &mdash; a passing test run, a commit, a push &mdash; and shiver when something fails.<br><br>
        Pick an atmosphere and set intensity, speed, pointer mode and Reduce Motion under
        <b>Settings | Appearance &amp; Behavior | Atmosphere</b>; switch or pause it for an hour from the status bar
        widget, or toggle it via <b>View | Appearance | Atmosphere</b>.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <!-- Commit and push reactions load only where version control (and Git) are present. -->
    <depends optional="true" config-file="ide-atmosphere-vcs.xml">com.intellij.modules.vcs</depends>
    <depends optional="true" config-file="ide-atmosphere-git.xml">Git4Idea</depends>

    <resource-bundle>messages.AtmosphereBundle</resource-bundle>


    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="info.chrzanowski.ideatmosphere.project.AtmosphereProjectActivity"/>

        <applicationConfigurable
                groupId="appearance"
                instance="info.chrzanowski.ideatmosphere.settings.AtmosphereSettingsConfigurable"
                id="info.chrzanowski.ideatmosphere.settings.AtmosphereSettingsConfigurable"
                displayName="Atmosphere"/>

        <externalSystemTaskNotificationListener
                implementation="info.chrzanowski.ideatmosphere.events.ExternalSystemActivityProducer"/>

        <!-- Status bar quick switch: pick an atmosphere, pause for an hour, open the settings. -->
        <statusBarWidgetFactory
                id="info.chrzanowski.ideatmosphere.statusBarWidget"
                implementation="info.chrzanowski.ideatmosphere.widget.AtmosphereStatusBarWidgetFactory"/>
    </extensions>

    <applicationListeners>
        <listener class="info.chrzanowski.ideatmosphere.listeners.AtmosphereLafListener"
                  topic="com.intellij.ide.ui.LafManagerListener"/>
        <listener class="info.chrzanowski.ideatmosphere.listeners.AtmospherePowerSaveListener"
                  topic="com.intellij.ide.PowerSaveMode$Listener"/>
        <listener class="info.chrzanowski.ideatmosphere.listeners.AtmosphereActivationListener"
                  topic="com.intellij.openapi.application.ApplicationActivationListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="info.chrzanowski.ideatmosphere.events.ExecutionActivityProducer"
                  topic="com.intellij.execution.ExecutionListener"/>
        <listener class="info.chrzanowski.ideatmosphere.events.DumbModeActivityProducer"
                  topic="com.intellij.openapi.project.DumbService$DumbModeListener"/>
        <listener class="info.chrzanowski.ideatmosphere.events.BuildActivityProducer"
                  topic="com.intellij.task.ProjectTaskListener"/>
        <!-- Test-run outcome from the test runner's result tree (one SUCCESS / FAILURE per run). -->
        <listener class="info.chrzanowski.ideatmosphere.events.TestResultActivityProducer"
                  topic="com.intellij.execution.testframework.sm.runner.SMTRunnerEventsListener"/>
    </projectListeners>

    <actions>
        <!-- View | Appearance | Atmosphere; text/description come from the resource bundle. -->
        <action id="info.chrzanowski.ideatmosphere.ToggleAtmosphereAction"
                class="info.chrzanowski.ideatmosphere.actions.ToggleAtmosphereAction">
            <add-to-group group-id="UIToggleActions" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
